# Copy to .env.compose and use docker compose --env-file .env.compose.
# Use separate, randomly generated passwords. Keep the same values for an existing volume.
DATADEAL_DB_ADMIN_PASSWORD=
DATADEAL_DB_PASSWORD=
BETTER_AUTH_SECRET=
DATADEAL_SCAN_LIMIT_SECRET=
ANTHROPIC_API_KEY=
APP_ORIGIN=https://datadeal.app
DATADEAL_WEB_PORT=3100

# Inject HEROUI_AUTH_TOKEN into the build process from the HeroUI license dashboard
# or a secret manager. Only the web image's dependency installation consumes it.

# Optional web integration settings are listed in .env.example and compose.yaml.
