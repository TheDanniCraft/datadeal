DATABASE_URL=
APP_ORIGIN=http://localhost:3000
# Public contact details shown on /privacy. Set on the web server.
DATADEAL_OPERATOR_NAME=
DATADEAL_PRIVACY_EMAIL=
DATADEAL_DEMO=false
# Development only (ignored when NODE_ENV=production): allow immediate rescans.
DATADEAL_DEV_SKIP_SCAN_COOLDOWN=false

# Worker. Production: Claude Console API key (Messages API).
ANTHROPIC_API_KEY=
DATADEAL_CLAUDE_MODEL=claude-opus-5-5
# low, medium or high
DATADEAL_CLAUDE_EFFORT=medium
# Local development only: token from `claude setup-token`, billed to your own
# Claude subscription. Used by tools/local-worker.mts, never by production.
CLAUDE_CODE_OAUTH_TOKEN=

DATADEAL_CONSENT_DOMAINS=*
# Maximum eligible public content pages per scan, in addition to the homepage (1–12).
CONTENT_PAGE_LIMIT=3
DATADEAL_BROWSER_PROXY=
# Worker only. Compare documented identifiers within one signed-out browser visit.
DATADEAL_COMPARE_VISIT_IDENTIFIERS=false

DATADEAL_TRUSTED_CLIENT_IP_HEADER=
DATADEAL_SCAN_LIMIT_SECRET=

BETTER_AUTH_SECRET=
DATADEAL_MAIL_MODE=
DATADEAL_LOCAL_MAIL_FILE=
RESEND_API_KEY=
DATADEAL_MAIL_FROM=

NEXT_PUBLIC_C15T_BACKEND_URL=

# Optional audience measurement. Use the website ID for this environment.
DATADEAL_UMAMI_ORIGIN=
DATADEAL_UMAMI_WEBSITE_ID=

DATADEAL_GOOGLE_AD_UNIT=
# Dedicated contextual inventory requested only with the limited Google ads preference.
DATADEAL_GOOGLE_LIMITED_AD_UNIT=

CREEM_MODE=
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_MONTHLY_PRODUCT=
CREEM_YEARLY_PRODUCT=
# Point packs (Creem test mode only, local points only): points:priceCents:productId,...
# Each product must be a one-time EUR product, different from the Pro products.
# Suggested: 10000:500:<product>,25000:1100:<product>,50000:2000:<product>
CREEM_POINT_PACKS=
# Earlier single API credit pack. Used only when CREEM_POINT_PACKS is unset:
# it is sold as one point pack of credits x 100 points.
CREEM_CREDIT_PACK_PRODUCT=
CREEM_CREDIT_PACK_CREDITS=
CREEM_CREDIT_PACK_PRICE_CENTS=
# Developer API requests are paid in points (saved report 150, new scan 150).
DATADEAL_DEVELOPER_API_PREVIEW=
# No longer used: API prices are point prices from @datadeal/contracts/paper-plane.
DATADEAL_API_REPORT_READ_CREDITS=
DATADEAL_API_SCAN_CREDITS=
DATADEAL_PRO_MONTHLY_CENTS=399
DATADEAL_PRO_YEARLY_CENTS=3499
