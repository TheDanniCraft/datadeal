# Worker, migration and egress target inputs. Do not negate directories.
**
!package.json
!bun.lock
!tsconfig.base.json
!apps/extension/package.json
!apps/web/package.json
!apps/worker/package.json
!apps/worker/*.ts
!apps/worker/browser-egress.mts
!apps/worker/tsconfig.json
!packages/ai/package.json
!packages/collector/package.json
!packages/config/package.json
!packages/contracts/package.json
!packages/database/package.json
!packages/scanner/package.json
!packages/scoring/package.json
!packages/ui/package.json
!packages/ai/*.ts
!packages/collector/*.ts
!packages/contracts/*.ts
!packages/database/*.ts
!packages/database/migrate.mjs
!packages/database/compose-migrate.mjs
!packages/database/migrations/[0-9][0-9][0-9][0-9]_*.sql
!packages/scanner/*.ts
!packages/scoring/*.ts

